{
  "name": "superviseur",
  "version": "0.1.0",
  "type": "module",
  "description": "Superviseur : hub d'attention pour les sessions OpenChamber",
  "scripts": {
    "start": "bun daemon/src/index.mts",
    "dev": "bun --watch daemon/src/index.mts",
    "build:ui": "bun run --cwd ui build",
    "dev:ui": "bun run --cwd ui dev",
    "typecheck:ui": "bun run --cwd ui typecheck"
  },
  "engines": { "bun": ">=1.2" }
}
