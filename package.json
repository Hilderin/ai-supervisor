{
  "name": "superviseur",
  "version": "0.1.0",
  "type": "module",
  "description": "Superviseur : hub d'attention pour les sessions OpenChamber",
  "scripts": {
    "start": "bun daemon/src/index.mts",
    "dev": "bun --watch daemon/src/index.mts",
    "build:ui": "bun run --cwd ui build",
    "dev:ui": "bun run --cwd ui dev",
    "typecheck:ui": "bun run --cwd ui typecheck",
    "app": "electron .",
    "build:exe": "bun scripts/build-exe.mts",
    "cleanup:companions": "bun daemon/scripts/cleanup-companions.mts",
    "test:verdict": "bun test daemon/test/verdict.test.mts"
  },
  "main": "electron/main.cjs",
  "author": "Skytech",
  "trustedDependencies": [
    "electron",
    "electron-builder"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
